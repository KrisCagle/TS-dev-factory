{
  "display_information": {
    "name": "AI Dev Factory",
    "description": "Sign-offs and decisions from your AI Dev Factory, with buttons to answer them.",
    "background_color": "#4f46e5"
  },
  "features": {
    "bot_user": { "display_name": "AI Dev Factory", "always_online": false }
  },
  "oauth_config": {
    "scopes": { "bot": ["chat:write", "chat:write.public"] }
  },
  "settings": {
    "interactivity": { "is_enabled": true },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
